{
  "schema_version": "1.0.0",
  "queries": {
    "application_requests": "sum by (pod) (rate(benchmark_work_requests_total{namespace=\"default\"}[10s]))",
    "application_errors": "sum(rate(benchmark_work_completed_total{namespace=\"default\",code!~\"2..\"}[10s])) or vector(0)",
    "application_internal_duration": "sum by (pod,le) (rate(benchmark_work_duration_seconds_bucket{namespace=\"default\"}[10s]))",
    "application_http_duration": "sum by (pod,code,le) (rate(benchmark_http_request_duration_seconds_bucket{namespace=\"default\",route=\"/work\"}[10s]))",
    "pod_cpu": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\",container=\"benchmark-app\"}[60s]))",
    "pod_memory": "sum by (pod) (container_memory_working_set_bytes{namespace=\"default\",container=\"benchmark-app\"})",
    "cpu_throttling_ratio": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"default\",container=\"benchmark-app\"}[60s])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"default\",container=\"benchmark-app\"}[60s]))",
    "cpu_throttled_seconds": "sum by (pod) (rate(container_cpu_cfs_throttled_seconds_total{namespace=\"default\",container=\"benchmark-app\"}[60s]))",
    "network_receive": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"default\",pod=~\"benchmark-app-.*\"}[60s]))",
    "network_transmit": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"default\",pod=~\"benchmark-app-.*\"}[60s]))",
    "pod_ready": "max by (pod) (kube_pod_status_ready{namespace=\"default\",condition=\"true\",pod=~\"benchmark-app-.*\"})",
    "pod_restarts": "max by (pod,container) (kube_pod_container_status_restarts_total{namespace=\"default\",container=\"benchmark-app\"})",
    "deployment_replicas": "kube_deployment_status_replicas{namespace=\"default\",deployment=\"benchmark-app\"}",
    "deployment_ready": "kube_deployment_status_replicas_ready{namespace=\"default\",deployment=\"benchmark-app\"}",
    "deployment_available": "kube_deployment_status_replicas_available{namespace=\"default\",deployment=\"benchmark-app\"}"
  }
}
